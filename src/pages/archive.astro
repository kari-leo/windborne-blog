---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";

const sortedPostsList = await getSortedPostsList();
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <section class="pt-20 pb-12 stagger">
        <h1 class="serif leading-[1.05] text-[clamp(2.25rem,5vw,4rem)] text-[var(--deep-text)] mb-3 tracking-tight">
          Everything, <em class="gradient-text not-italic"><span class="serif italic">in order</span></em>.
        </h1>
        <p class="text-base text-[var(--btn-content)] mb-8">A complete record of what I've written here.</p>
        <div class="soft-divider mb-8"></div>
        <div class="reveal">
          <ArchivePanel sortedPosts={sortedPostsList} client:only="svelte"></ArchivePanel>
        </div>
    </section>
</MainGridLayout>
