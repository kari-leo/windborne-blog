---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import LeftRail from "@components/LeftRail.astro";
import Navbar from "@components/Navbar.astro";
import type { MarkdownHeading } from "astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const { title, description, lang, setOGTypeArticle, headings = [] } = Astro.props;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<slot slot="head" name="head"></slot>

<!-- Navbar -->
<div id="top-row" class="z-50 sticky top-0 pointer-events-none">
    <div id="navbar-wrapper" class="pointer-events-auto transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Two-column shell -->
<div class="relative z-10 max-w-[var(--page-width)] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[16rem_1fr] gap-10 lg:gap-16">
        <!-- Left sidebar — sticky author + nav -->
        <LeftRail />

        <!-- Main column -->
        <div class="min-w-0">
            <!-- Hero slot -->
            <slot name="hero"></slot>

            <main id="swup-container" class="transition-swup-fade w-full">
                <div id="content-wrapper" class="onload-animation">
                    <slot></slot>
                </div>
            </main>

            <Footer></Footer>
        </div>
    </div>

    <BackToTop></BackToTop>
</div>

<!-- TOC: only on very wide screens -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        {siteConfig.toc.enable && <div id="toc-wrapper" class="hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center">
            <div id="toc-inner-wrapper" class="fixed top-20 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>

<style>
    #navbar-wrapper {
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        background: color-mix(in srgb, var(--page-bg) 75%, transparent);
        border-bottom: 1px solid var(--line-divider);
    }
    .navbar-hidden { @apply opacity-0 -translate-y-16; }
</style>
