/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 0.5rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

/* Vercel-inspired neutral palette with cyan-teal tech accent */
/* Light: #fafafa canvas, #171717 ink text, #0ea5e9 accent */
/* Dark:  #0a0a0a base, #ededed text, #38bdf8 accent */

define({
  /* Accent — cyan-to-teal tech feel */
  --primary: #0ea5e9 #38bdf8

  /* Page & card surfaces */
  --page-bg: #fafafa #0a0a0a
  --card-bg: #ffffff #111111

  /* Button text */
  --btn-content: #525252 #a3a3a3

  /* Filled button (regular) */
  --btn-regular-bg: #f5f5f5 #1a1a1a
  --btn-regular-bg-hover: #e5e5e5 #242424
  --btn-regular-bg-active: #d4d4d4 #2e2e2e

  /* Plain / ghost button hover fills */
  --btn-plain-bg-hover: #f5f5f5 #1a1a1a
  --btn-plain-bg-active: #e5e5e5 #222222

  /* Card hover/active fills */
  --btn-card-bg-hover: #f9f9f9 #161616
  --btn-card-bg-active: #f0f0f0 #1e1e1e

  /* Enter-post arrow button */
  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  /* Deep heading text */
  --deep-text: #171717 #ededed

  /* Title active state */
  --title-active: #0284c7 #7dd3fc

  /* Dividers */
  --line-divider: rgba(0,0,0,0.07) rgba(255,255,255,0.07)
  --line-color: rgba(0,0,0,0.08) rgba(255,255,255,0.08)
  --meta-divider: rgba(0,0,0,0.18) rgba(255,255,255,0.18)

  /* Inline code */
  --inline-code-bg: #f0f9ff #082f49
  --inline-code-color: #0369a1 #7dd3fc

  /* Selection */
  --selection-bg: #bae6fd #0c4a6e

  /* Code blocks */
  --codeblock-selection: #1e3a5f
  --codeblock-bg: #0f172a #0f172a
  --codeblock-topbar-bg: #1e293b #0d1424

  /* License block */
  --license-block-bg: rgba(0,0,0,0.02) #0f172a

  /* Link decoration */
  --link-underline: #bae6fd #0c4a6e
  --link-hover: #e0f2fe #083344
  --link-active: #bae6fd #0c4a6e

  /* Float panels (search, menus) */
  --float-panel-bg: #ffffff #111111

  /* Scrollbar */
  --scrollbar-bg-light: black(0.25)
  --scrollbar-bg-hover-light: black(0.4)
  --scrollbar-bg-active-light: black(0.55)

  --scrollbar-bg-dark: white(0.2)
  --scrollbar-bg-hover-dark: white(0.35)
  --scrollbar-bg-active-dark: white(0.5)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  /* Top selection bar — keep rainbow for fun */
  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  /* Admonitions */
  --admonitions-color-tip: #059669 #34d399
  --admonitions-color-note: #0ea5e9 #38bdf8
  --admonitions-color-important: #8b5cf6 #a78bfa
  --admonitions-color-warning: #f59e0b #fbbf24
  --admonitions-color-caution: #ef4444 #f87171

  /* TOC */
  --toc-badge-bg: #f0f9ff #082f49
  --toc-btn-hover: #f5f5f5 #1a1a1a
  --toc-btn-active: #e5e5e5 #222222
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: #0ea5e9 #38bdf8
})
