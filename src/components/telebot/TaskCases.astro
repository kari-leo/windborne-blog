---
import { getProjectDocumentUrl, url } from "@utils/url-utils";
import { taskCases } from "./content";
---

<telebot-task-cases>
  <div class="case-tabs" role="tablist" aria-label="任务场景" hidden data-pagefind-ignore>
    {taskCases.map((task, index) => <button type="button" id={`telebot-tab-${task.id}`} role="tab" aria-selected={index === 0} aria-controls={`telebot-panel-${task.id}`} tabindex={index === 0 ? 0 : -1} data-case={task.id}>{task.label}</button>)}
  </div>
  {taskCases.map((task) => <div class="case-layout" id={`telebot-panel-${task.id}`} data-panel={task.id}>
    <div class="case-recording">
      <div class="video-heading"><span>飞书 / {task.label}</span><span>功能录屏</span></div>
      <video controls playsinline preload="none" aria-label={task.videoLabel}>
        <source src={url(`/videos/telebot/${task.video}`)} type="video/mp4" />
        <a href={url(`/videos/telebot/${task.video}`)}>打开{task.label}演示视频</a>
      </video>
      <div class="request"><p>{task.id === "schedule" ? "每天凌晨 · 任务设定" : "任务设定示例"}</p><blockquote>{task.request}</blockquote></div>
      {task.id === "schedule" && <table class="change-table">
        <caption>岗位变更表 · 汇总格式</caption>
        <thead><tr><th scope="col">类型</th><th scope="col">岗位方向</th><th scope="col">汇总内容</th></tr></thead>
        <tbody><tr><td>新增</td><td>机器人产品经理</td><td>新增岗位与来源链接</td></tr><tr><td>修改</td><td>具身智能产品经理</td><td>修改字段及前后差异</td></tr></tbody>
      </table>}
    </div>
    <div class="case-copy">
      <p class="kicker">{task.kicker}</p><h3>{task.title}</h3>
      <dl><div><dt>任务目标</dt><dd>{task.goal}</dd></div><div><dt>用户提供</dt><dd>{task.input}</dd></div><div><dt>得到的结果</dt><dd>{task.delivery}</dd></div></dl>
      <div class="decision"><p>关键取舍</p><div>{task.decision}</div></div>
      <a class="text-link" href={getProjectDocumentUrl("telebot", task.document)}>{task.linkLabel}<span aria-hidden="true">↗</span></a>
    </div>
  </div>)}
  <p class="supporting"><span>支撑能力</span><span>项目知识检索</span><span>Codex 本地执行</span></p>
</telebot-task-cases>

<style>
  telebot-task-cases { display: block; }
  .case-tabs { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-block: 1rem 1.5rem; border-bottom: 1px solid var(--line-color); }
  .case-tabs button { min-height: 2.75rem; border-bottom: 2px solid transparent; padding-block: .625rem; color: var(--btn-content); font-size: .8125rem; }
  .case-tabs button[aria-selected="true"] { color: var(--primary); border-bottom-color: var(--primary); }
  .case-tabs button:hover { color: var(--primary); }
  .case-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2rem; align-items: start; margin-top: 1.5rem; }
  .case-recording, .case-copy { min-width: 0; }
  .case-recording { border: 1px solid var(--line-color); border-radius: .75rem; overflow: hidden; background: var(--card-bg); }
  .video-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; padding: .75rem 1rem; border-bottom: 1px solid var(--line-color); color: var(--btn-content); font-size: .75rem; }
  video { display: block; width: 100%; height: clamp(22rem, 40vw, 32rem); object-fit: contain; background: var(--codeblock-bg); }
  .request { border-top: 1px solid var(--line-color); padding: 1rem; }
  .request > p { color: var(--btn-content); font-size: .75rem; margin-bottom: .5rem; }
  blockquote { padding: .75rem; border-radius: .5rem; background: var(--btn-regular-bg); color: var(--deep-text); font-size: .8125rem; line-height: 1.85; overflow-wrap: anywhere; }
  .kicker { color: var(--btn-content); font-size: .75rem; margin-block: .25rem .5rem; }
  h3 { font-size: clamp(1.125rem, 2vw, 1.375rem); line-height: 1.6; margin-bottom: 1.25rem; text-wrap: balance; }
  dl { display: grid; gap: 1rem; font-size: .875rem; line-height: 1.8; }
  dt { font-weight: 600; margin-bottom: .25rem; }
  dd { color: var(--btn-content); overflow-wrap: anywhere; }
  .decision { border-left: 2px solid var(--primary); padding-left: 1rem; margin-top: 1.5rem; font-size: .8125rem; line-height: 1.85; }
  .decision > p { color: var(--primary); font-size: .75rem; margin-bottom: .375rem; }
  .decision > div { color: var(--btn-content); }
  .text-link { display: inline-flex; gap: 1rem; align-items: center; min-height: 2.75rem; color: var(--primary); font-size: .8125rem; margin-top: 1rem; }
  .text-link:hover { text-decoration: underline; }
  .supporting { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: 1.25rem; color: var(--btn-content); font-size: .75rem; }
  .supporting > span:first-child { color: var(--primary); }
  .change-table { width: calc(100% - 2rem); margin: 0 1rem 1rem; table-layout: fixed; border-collapse: collapse; font-size: .75rem; text-align: left; line-height: 1.75; overflow-wrap: anywhere; }
  caption { text-align: left; padding-block: .25rem .75rem; color: var(--btn-content); }
  th, td { padding: .5rem .375rem; border-bottom: 1px solid var(--line-color); vertical-align: top; }
  th { font-weight: 500; } th:first-child { width: 18%; } th:nth-child(2) { width: 38%; }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--primary); outline-offset: 4px; }
  [hidden] { display: none; }
  @container telebot-overview (max-width: 40rem) { .case-layout { grid-template-columns: 1fr; gap: 1.5rem; } .case-tabs { gap: .5rem 1rem; } }
  @container telebot-overview (max-width: 24rem) { video { height: auto; aspect-ratio: 9 / 20; } }
</style>

<script>
  class TelebotTaskCases extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-case]"));
      this.querySelector<HTMLElement>('[role="tablist"]')?.removeAttribute("hidden");
      this.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", `telebot-tab-${panel.dataset.panel}`);
      });
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => this.select(tab.dataset.case), { signal });
        tab.addEventListener("keydown", (event) => {
          let nextIndex = index;
          if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          this.select(tabs[nextIndex].dataset.case);
          tabs[nextIndex].focus();
        }, { signal });
      });
      this.select(tabs[0]?.dataset.case);
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.querySelectorAll("video").forEach((video) => video.pause());
    }

    private select(id?: string) {
      this.querySelectorAll<HTMLButtonElement>("[data-case]").forEach((tab) => {
        const selected = tab.dataset.case === id;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      this.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
        const video = panel.querySelector("video");
        if (panel.hidden) video?.pause();
        else if (video?.preload === "none") { video.preload = "metadata"; video.load(); }
      });
    }
  }

  if (!customElements.get("telebot-task-cases")) {
    customElements.define("telebot-task-cases", TelebotTaskCases);
  }
</script>
