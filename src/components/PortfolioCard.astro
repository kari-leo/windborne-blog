---
import type { CollectionEntry } from "astro:content";
import { getProjectUrlBySlug } from "@utils/url-utils";

interface Props {
	entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, description, status, tags } = entry.data;
---

<article class="group min-w-0">
	<a href={getProjectUrlBySlug(entry.slug)} class="portfolio-card flex h-full min-h-64 flex-col rounded-xl border border-[var(--line-color)] bg-[var(--card-bg)] p-6 md:p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--primary)]/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]">
		<div class="flex items-start justify-between gap-4">
			<span class="text-[0.7rem] font-semibold uppercase tracking-[0.15em] text-[var(--btn-content)]">{status}</span>
			<span aria-hidden="true" class="text-xl leading-none text-[var(--btn-content)] transition-transform duration-300 group-hover:translate-x-1 group-hover:text-[var(--primary)]">&nearr;</span>
		</div>
		<div class="mt-auto pt-10">
			<h2 class="serif mb-3 text-[clamp(2rem,3vw,2.7rem)] leading-none text-[var(--deep-text)] transition-colors duration-300 group-hover:text-[var(--primary)]">{title}</h2>
			{description && <p class="max-w-xl text-sm leading-relaxed text-[var(--btn-content)]">{description}</p>}
			{tags.length > 0 && <div class="mt-5 flex flex-wrap gap-2">{tags.map((tag) => <span class="rounded-full border border-[var(--line-color)] px-2.5 py-1 text-[0.7rem] text-[var(--btn-content)]">{tag}</span>)}</div>}
		</div>
	</a>
</article>
