---
import { Icon } from "astro-icon/components";
---

<button id="back-to-top-btn" aria-label="Back to Top" class="back-to-top hide" style="opacity:0; transform:translateY(8px); pointer-events:none;" onclick="backToTop()">
    <div class="mono text-[9px] uppercase tracking-[0.18em] mb-1">TOP</div>
    <Icon name="material-symbols:keyboard-arrow-up-rounded" class="text-base" />
</button>

<style>
    .back-to-top {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 40;
        width: 3rem;
        height: 3rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        background: var(--card-bg);
        border: 1px solid var(--line-color);
        color: var(--deep-text);
        cursor: pointer;
        opacity: 1;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }
    .back-to-top:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-2px);
    }
    .back-to-top.hide {
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
    }
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
