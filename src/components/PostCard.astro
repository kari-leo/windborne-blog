---
import type { CollectionEntry } from "astro:content";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	index?: number;
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const { remarkPluginFrontmatter } = await entry.render();

const monthShort = published.toLocaleString("en-US", { month: "short" });
const day = published.getDate();
---
<article class:list={["group post-row relative reveal", className]} style={style}>
  <a href={url} aria-label={title} class="block py-7 md:py-8 relative">

    <div class="grid grid-cols-12 gap-4 md:gap-8 items-baseline">
      <!-- Date column -->
      <div class="col-span-12 md:col-span-2 text-sm text-[var(--btn-content)] flex md:block items-baseline gap-2 transition-colors duration-300 group-hover:text-[var(--deep-text)]">
        <span class="serif italic text-base">{monthShort}</span>
        <span class="md:block">{day}</span>
      </div>

      <!-- Main content -->
      <div class="col-span-12 md:col-span-10">
        {category && (
          <div class="text-xs uppercase tracking-[0.1em] text-[var(--btn-content)] mb-2">
            {category}
          </div>
        )}

        <h2 class="serif leading-[1.1] text-[clamp(1.35rem,2vw,1.85rem)] text-[var(--deep-text)] mb-2 transition-all duration-500 ease-out group-hover:italic group-hover:text-[var(--primary)] group-hover:translate-x-1">
          {title}
        </h2>

        <p class="text-sm md:text-base text-[var(--btn-content)] leading-relaxed mb-2.5 max-w-2xl line-clamp-2">
          {description || remarkPluginFrontmatter.excerpt}
        </p>

        <div class="text-sm text-[var(--btn-content)] flex flex-wrap items-center gap-x-3 gap-y-1">
          <span>{remarkPluginFrontmatter.minutes} min read</span>
          {tags && tags.length > 0 && tags.slice(0, 3).map(t => (
            <>
              <span class="text-[var(--meta-divider)]">·</span>
              <span class="serif italic">{t}</span>
            </>
          ))}
          <span class="ml-1 inline-flex items-baseline gap-1.5 text-[var(--primary)] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-400">
            <span>read</span>
            <svg width="16" height="9" viewBox="0 0 16 9" fill="none">
              <path d="M0 4.5 L13 4.5 M10 1 L13 4.5 L10 8" stroke="currentColor" stroke-width="1" fill="none"/>
            </svg>
          </span>
        </div>
      </div>
    </div>

    <!-- Hairline that softens to primary on hover -->
    <div class="absolute bottom-0 left-0 right-0 h-px bg-[var(--line-color)] transition-colors duration-500 group-hover:bg-[var(--primary)]/35"></div>

    <!-- soft horizontal sweep on hover -->
    <div class="absolute inset-y-2 left-0 right-0 -z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-lg"
         style="background: linear-gradient(to right, color-mix(in srgb, var(--primary) 6%, transparent), transparent 60%);"></div>
  </a>
</article>
