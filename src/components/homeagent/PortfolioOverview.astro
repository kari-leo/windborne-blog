---
import type { CollectionEntry } from "astro:content";
import { getProjectDocumentUrl } from "@utils/url-utils";
import RobotForm from "./RobotForm.astro";
interface Props { documents: CollectionEntry<"projectDocuments">[]; }
const { documents } = Astro.props;
const doc = (slug: string) => getProjectDocumentUrl("homeagent", slug);
type WorkKind = "design" | "decision" | "document";
type Preview = "homeagent" | "retask" | "decision" | "document";
interface WorkDetails { title: string; description: string; kind: WorkKind; preview: Preview; order: number; product?: string; }
const details: Record<string, WorkDetails> = {
  "homeagent-showcase": { title: "HomeAgent｜家庭物理执行终端", description: "床上休息时取书的场景、产品形态与可操作交互原型。", kind: "design", preview: "homeagent", order: 10 },
  "retask-showcase": { title: "ReTask｜仓储移动操作系统", description: "受限包裹操作、两工位切换场景与成功 / 异常交互原型。", kind: "design", preview: "retask", order: 20 },
  "decision-case-study": { title: "从 HomeAgent 到 ReTask", description: "为什么转向 ToB、选择 3PL，并把通用能力收敛到具体工位？", kind: "decision", preview: "decision", order: 30 },
  "home-agent": { title: "HomeAgent｜产品说明", description: "家庭需求、候选任务、权限与安全边界，以及商业模式与竞品比较。", kind: "document", preview: "document", product: "HomeAgent", order: 50 },
  "retask": { title: "ReTask｜产品说明", description: "3PL 客户、包裹操作边界、系统模块与跨工位复用的经济性。", kind: "document", preview: "document", product: "ReTask", order: 60 },
};
const kindNames: Record<WorkKind, string> = { design: "产品设计", decision: "关键决策", document: "产品说明" };
const works = documents.map((entry) => {
  const slug = entry.slug.split("/").at(-1) ?? entry.slug;
  const detail = details[slug] ?? { title: entry.data.title, description: entry.data.description, kind: "document" as const, preview: "document" as const, order: 100 + entry.data.order };
  return { ...detail, slug, fullTitle: entry.data.title, href: doc(slug), kindName: kindNames[detail.kind] };
}).sort((a, b) => a.order - b.order);
const filters = [
  { key: "all", label: "全部" }, { key: "design", label: "产品设计" },
  { key: "decision", label: "关键决策" }, { key: "document", label: "产品说明" },
];
---
<article class="portfolio-overview" data-pagefind-body>
  <header class="project-hero"><span id="problem" class="section-anchor" aria-hidden="true"></span>
    <p class="eyebrow"><span>01</span> 问题起点 · 移动操作机器人</p>
    <h1 class="serif">HomeAgent <span>/</span> ReTask</h1>
    <div class="opening-story"><div class="story-lead">
    <p class="hero-question">一台能操作实物的机器人，<br class="mobile-break" />应该先为谁创造价值？</p>
    <p class="hero-description">智能家居已经能控制联网设备，但对没有联网接口、位置会变化的实体物品，仍缺少灵活的执行端。HomeAgent 从这一缺口出发，探索让家庭成员在休息或忙于其他事情时，也能委托室内取送。</p>
    <dl class="problem-details">
      <div><dt>为谁解决</dt><dd>从正在休息或专注其他事务的家庭成员出发：一次短距离取物会中断当前状态，能否由机器人代为完成？自己起身、请家人帮忙或提前准备，仍是需要比较的办法。</dd></div>
      <div><dt>从什么任务切入</dt><dd>用户在卧室床上休息，希望取来客厅预设位置的一本书。选择物品与床边指定交付区后，机器人模拟取书和运送，送达后由用户确认收到。</dd></div>
      <div><dt>怎样判断值得做</dt><dd>比较实际发生频率、现有替代方案、用户已承担的成本，以及失败后的接管负担；同时检验家庭成员能否接受权限、影像与操作边界。</dd></div>
    </dl>
    <a class="project-documents-link" href="#products">查看项目文档 <span aria-hidden="true">↓</span></a>
    </div>
  <section class="story-section" aria-labelledby="decisions-heading"><span id="decisions" class="section-anchor" aria-hidden="true"></span>
    <div class="section-heading"><span>02</span><h2 id="decisions-heading">从家庭愿景，走向可界定的仓储任务</h2></div>
    <div class="direction-comparison">
      <div><p class="direction-label">HomeAgent · 初始方向</p><h3>通用能力，能成为购买理由吗？</h3><p>家庭通用机器人拥有很大的想象空间，但取送、整理与远程协助各自面对不同的需求和交付难度。覆盖更多家务，也意味着承担更多可靠性与维护成本：哪一项真实事务，值得用户为整台设备付费？</p></div>
      <div><p class="direction-label">ToB / 3PL · 场景选择</p><h3>为什么把下一步放在仓储？</h3><p>企业任务可以围绕人工作业、有效件数与停工成本建立比较口径，却也带来集成和采购门槛。多客户 3PL 可能存在固定自动化难以经济覆盖的包裹操作：先解决哪一种任务，才能证明这台机器人有必要？</p></div>
      <div><p class="direction-label">ReTask · 方案取舍</p><h3>有了仓储任务，为什么还要移动？</h3><p>一套固定设备、人工跨站支援，或让机器人在两站之间共享，都是候选方案。移动增加了迁移、校准与切换的代价；它能否换来足够的利用率与配置节约，让同一台设备服务两个工位更划算？</p></div>
    </div>
  </section>
    </div>
  </header>

  <section class="works-section" aria-labelledby="works-heading"><span id="products" class="section-anchor" aria-hidden="true"></span>
    <div class="section-heading"><span>03</span><h2 id="works-heading">研究与设计成果</h2></div>
    <p class="works-intro">从两款产品的形态与交互，进一步了解方向取舍、系统边界与具体功能。</p>
    <project-work-gallery>
      <div class="work-tools" data-work-tools hidden data-pagefind-ignore>
        <div class="tool-topline"><div class="work-filters" role="group" aria-label="按成果类型筛选">{filters.map((filter) => <button type="button" data-work-filter={filter.key} aria-pressed={filter.key === "all"}>{filter.label}</button>)}</div><output class="work-count" aria-live="polite" aria-atomic="true" data-work-count>{works.length} 份研究与设计成果</output></div>
      </div>
      <div class="work-grid" id="project-work-grid">{works.map((work) => <article class="work-card" data-work-kind={work.kind}>
        <a href={work.href} aria-label={`${work.fullTitle}，${work.kindName}`}>
          <div class="work-preview" aria-hidden="true">
            {work.preview === "homeagent" || work.preview === "retask" ? <RobotForm product={work.preview} compact /> : work.preview === "decision" ? <div class="decision-preview">{["家庭通用执行", "可度量的企业任务", "多客户 3PL 仓储", "受限任务与工位复用"].map((step, index) => <div><span>0{index + 1}</span><strong>{step}</strong></div>)}</div> : <div class="definition-preview"><strong class="serif">{work.product ?? "产品定义"}</strong><p>{work.product === "HomeAgent" ? "家庭需求 / 受限取送 / 权限边界" : work.product === "ReTask" ? "3PL 任务 / 工位复用 / 配置经济性" : "产品场景 / 系统边界 / 验证路径"}</p><span>场景 → 任务 → 系统</span></div>}
          </div>
          <div class="card-copy"><div class="card-meta"><span>{work.kindName}</span>{work.kind === "design" && <span>概念方案</span>}</div><h3>{work.title}</h3><p>{work.description}</p><span class="card-action"><span>{work.kind === "design" ? "查看产品设计" : work.kind === "decision" ? "阅读关键决策" : "阅读产品说明"}</span><span class="card-arrow" aria-hidden="true">↗</span></span></div>
        </a>
      </article>)}</div>
      <div class="empty-state" data-work-empty hidden><h3>该类型暂无作品</h3><button type="button" data-work-reset>查看全部作品</button></div>
    </project-work-gallery>
  </section>
</article>

<style>
  .portfolio-overview { color: var(--deep-text); container-type: inline-size; container-name: project-overview; }
  .project-hero, .story-section, .works-section { position: relative; }
  .section-anchor { position: absolute; top: -5.5rem; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .project-hero { scroll-margin-top: 5.5rem; padding-block: .5rem 1rem; }
  .eyebrow { color: var(--btn-content); font-size: .75rem; line-height: 1.5; } .eyebrow > span { color: var(--primary); margin-right: .5rem; font-variant-numeric: tabular-nums; }
  h1 { font-size: clamp(2.8rem, 5.625vw, 4.5rem); font-weight: 400; line-height: 1.1; letter-spacing: -.025em; margin: 1rem 0 1.5rem; } h1 > span { color: var(--primary); }
  .hero-question { font-size: clamp(1.25rem, 2.3vw, 1.65rem); font-weight: 600; line-height: 1.5; letter-spacing: -.025em; } .mobile-break { display: inline; }
  .hero-description { margin-top: .75rem; max-width: 44rem; color: var(--btn-content); font-size: .9375rem; line-height: 1.85; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--primary); outline-offset: 4px; }
  section { margin-top: 2.5rem; scroll-margin-top: 5.5rem; } .section-heading { display: flex; gap: .75rem; align-items: baseline; } .section-heading > span { color: var(--primary); font-size: .75rem; font-variant-numeric: tabular-nums; } h2 { font-size: clamp(1.25rem, 2.4vw, 1.625rem); line-height: 1.5; font-weight: 600; }
  .direction-comparison { display: grid; grid-template-columns: 1fr; gap: 1.25rem; align-items: start; margin-top: 1.25rem; } .direction-comparison > div { border-left: 2px solid var(--line-color); padding-left: 1rem; }
  .direction-label { color: var(--btn-content); font-size: .75rem; line-height: 1.6; } .direction-comparison h3 { font-size: .9375rem; font-weight: 500; line-height: 1.6; margin: .375rem 0; } .direction-comparison > div > p:last-child { color: var(--btn-content); font-size: .8125rem; line-height: 1.8; }
  .works-section { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line-color); } .works-intro { color: var(--btn-content); font-size: .875rem; line-height: 1.8; margin-top: .5rem; }
  project-work-gallery { display: block; }
  .work-tools { position: sticky; top: 3.5rem; z-index: 10; display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: .75rem; padding-block: .875rem; margin: 1rem 0; background: var(--page-bg); border-block: 1px solid var(--line-color); }
  .tool-topline { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; width: 100%; } .work-filters { display: flex; flex-wrap: wrap; gap: .375rem; } .work-filters > button { min-height: 2.5rem; padding: .5rem .625rem; border: 1px solid transparent; border-radius: .35rem; color: var(--btn-content); font-size: .75rem; line-height: 1.5; white-space: nowrap; } .work-filters > button:hover { background: var(--btn-plain-bg-hover); color: var(--deep-text); } .work-filters > button[aria-pressed="true"] { border-color: var(--line-color); background: var(--btn-regular-bg); color: var(--primary); font-weight: 600; }
  .work-count { color: var(--btn-content); font-size: .75rem; line-height: 1.6; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .work-card { min-width: 0; } .work-card > a { display: flex; flex-direction: column; height: 100%; min-height: 22.5rem; overflow: hidden; border: 1px solid var(--line-color); border-radius: .75rem; background: var(--card-bg); transition: border-color 160ms ease, transform 160ms ease; }
  .work-preview { display: flex; align-items: center; justify-content: center; height: 10rem; flex: 0 0 10rem; padding: .75rem; background: var(--btn-regular-bg); border-bottom: 1px solid var(--line-color); }
  .work-preview :global(.robot-form) { width: 15rem; max-width: 100%; --robot-accent: var(--primary); }
  .decision-preview { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem 1rem; width: 100%; max-width: 20rem; } .decision-preview > div { border-left: 1px solid var(--line-color); padding-left: .75rem; } .decision-preview span { display: block; color: var(--primary); font-size: .6875rem; margin-bottom: .25rem; } .decision-preview strong { font-size: .75rem; line-height: 1.6; font-weight: 500; }
  .definition-preview { width: 100%; max-width: 20rem; padding: .5rem .75rem; } .definition-preview > strong { display: block; font-size: 1.75rem; font-weight: 400; line-height: 1.2; } .definition-preview > p { margin-top: .75rem; color: var(--btn-content); font-size: .75rem; line-height: 1.8; } .definition-preview > span { display: block; font-size: .75rem; color: var(--primary); margin-top: .75rem; }
  .card-copy { display: flex; flex-direction: column; flex: 1; padding: 1.25rem; } .card-meta { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: space-between; color: var(--btn-content); font-size: .75rem; line-height: 1.5; } .card-meta > span:last-child:not(:first-child) { color: var(--primary); }
  .card-copy h3 { font-size: 1.125rem; font-weight: 600; line-height: 1.5; letter-spacing: -.025em; margin-top: .75rem; } .card-copy > p { color: var(--btn-content); font-size: .875rem; line-height: 1.75; margin-top: .625rem; } .card-action { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--primary); font-size: .8125rem; line-height: 1.6; padding-top: 1.25rem; margin-top: auto; } .card-arrow { transition: transform 160ms ease; }
  .work-card > a:focus-visible { border-color: var(--primary); outline-offset: 3px; }
  @media (hover: hover) { .work-card > a:hover { border-color: var(--primary); transform: translateY(-2px); } .work-card > a:hover .card-arrow { transform: translateX(3px); } }
  .empty-state { padding: 3rem 1.5rem; text-align: center; border: 1px dashed var(--line-color); border-radius: .75rem; margin-top: 1.5rem; } .empty-state h3 { font-size: 1rem; } .empty-state p { font-size: .875rem; line-height: 1.8; color: var(--btn-content); margin-top: .5rem; } .empty-state button { min-height: 2.75rem; border: 1px solid var(--line-color); border-radius: .35rem; padding: .5rem 1rem; font-size: .8125rem; color: var(--primary); background: var(--card-bg); margin-top: 1rem; }
  .work-tools[hidden], .work-card[hidden], .empty-state[hidden] { display: none; }
  .opening-story { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2rem; margin-top: 2rem; }
  .opening-story .hero-question { font-size: 1.625rem; line-height: 1.6; } .opening-story .hero-description { font-size: 1rem; margin-top: 1.25rem; }
  .problem-details { display: grid; gap: 1.25rem; margin-top: 1.75rem; }
  .problem-details dt { font-size: .875rem; font-weight: 600; line-height: 1.6; }
  .problem-details dd { font-size: .875rem; line-height: 1.85; color: var(--btn-content); margin-top: .375rem; }
  .project-documents-link { display: inline-flex; gap: 1rem; align-items: center; min-height: 2.75rem; color: var(--primary); font-size: .8125rem; margin-top: 1.5rem; } .project-documents-link:hover { text-decoration: underline; }
  .story-section { margin-top: 0; border-left: 1px solid var(--line-color); padding-left: 2rem; }
  .story-section h2 { font-size: 1.375rem; text-wrap: balance; }
  .story-section .direction-label { font-size: .8125rem; }
  .story-section .direction-comparison { grid-template-columns: 1fr; gap: 1.25rem; margin-top: 1.5rem; }
  .story-section .direction-comparison h3 { font-size: 1rem; margin-block: .5rem; }
  .story-section .direction-comparison > div > p:last-child { font-size: .875rem; }
  @container project-overview (max-width: 44rem) { .opening-story { grid-template-columns: 1fr; gap: 1.5rem; } .story-section { border-left: none; border-top: 1px solid var(--line-color); padding-left: 0; padding-top: 1.5rem; } .story-section .direction-comparison { grid-template-columns: 1fr 1fr; } .direction-comparison > div:last-child { grid-column: 1 / -1; } }
  @container project-overview (max-width: 36rem) { .work-grid { grid-template-columns: 1fr; gap: 1rem; } .direction-comparison { grid-template-columns: 1fr; gap: .75rem; } .work-tools { gap: .5rem; } .work-filters { gap: .25rem; } .work-filters > button { min-height: 2.75rem; padding-inline: .5rem; } .work-count { margin-left: auto; } .mobile-break { display: inline; } .card-copy { padding: 1rem; } section { margin-top: 2rem; } .opening-story .hero-question { font-size: 1.5rem; } }
  @container project-overview (max-width: 36rem) { .story-section { margin-top: 0; } .story-section .direction-comparison { grid-template-columns: 1fr; } .direction-comparison > div:last-child { grid-column: auto; } }
  @media (prefers-reduced-motion: reduce) { .work-card > a, .card-arrow { transition: none; } .work-card > a:hover, .work-card > a:hover .card-arrow { transform: none; } }
</style>

<script>
  class ProjectWorkGallery extends HTMLElement {
    private controller?: AbortController;
    private activeFilter = "all";

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.activeFilter = "all";
      this.querySelector<HTMLElement>("[data-work-tools]")?.removeAttribute("hidden");
      this.querySelectorAll<HTMLButtonElement>("[data-work-filter]").forEach((button) => {
        button.addEventListener("click", () => {
          this.activeFilter = button.dataset.workFilter ?? "all";
          this.updateResults();
        }, { signal });
      });
      this.querySelector<HTMLButtonElement>("[data-work-reset]")?.addEventListener("click", () => {
        this.activeFilter = "all";
        this.updateResults();
        this.querySelector<HTMLButtonElement>('[data-work-filter="all"]')?.focus();
      }, { signal });
      this.updateResults();
    }

    disconnectedCallback() {
      this.controller?.abort();
    }

    private updateResults() {
      const cards = Array.from(this.querySelectorAll<HTMLElement>("[data-work-kind]"));
      let visibleCount = 0;
      cards.forEach((card) => {
        const matches = this.activeFilter === "all" || card.dataset.workKind === this.activeFilter;
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      });
      this.querySelectorAll<HTMLButtonElement>("[data-work-filter]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.workFilter === this.activeFilter));
      });
      const count = this.querySelector<HTMLOutputElement>("[data-work-count]");
      if (count) count.textContent = visibleCount === cards.length ? `${cards.length} 份研究与设计成果` : `${visibleCount} / ${cards.length} 份成果`;
      const empty = this.querySelector<HTMLElement>("[data-work-empty]");
      if (empty) empty.hidden = visibleCount !== 0;
    }
  }
  if (!customElements.get("project-work-gallery")) customElements.define("project-work-gallery", ProjectWorkGallery);
</script>
