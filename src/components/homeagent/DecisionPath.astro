---
const nodes = [
  { title: "家庭通用物理执行终端", question: "真实任务足够高频，且值得购置一台机器人吗？", direction: "暂缓直接产品化；保留物理执行愿景", alternative: "备选：专用设备 / 服务替代 / 受限家庭 MVP" },
  { title: "优先寻找可度量的 ToB 任务", question: "谁承担当前成本，如何与替代方案公平比较？", direction: "从具体业务结果建立验证口径", alternative: "备选：继续家庭问题发现 / ToB 受限任务" },
  { title: "多客户 3PL 仓储候选场景", question: "是否存在真实人工缺口与设备共享窗口？", direction: "优先研究受限非标包裹重新上件", alternative: "备选：稳定合同仓 / 高度自动化分拨 / 逆向物流" },
  { title: "ReTask：受限任务与两工位复用", question: "迁移与重新配置节约能否覆盖移动溢价？", direction: "先测固定工位，再检验 A → B 复用", alternative: "若复用不成立：转向固定工作站 / 抓取软件" },
];
---
<figure class="decision-path" aria-labelledby="path-caption">
  <figcaption id="path-caption"><span>方向收敛</span><strong>用约束逐步收敛产品边界</strong></figcaption>
  <ol>{nodes.map((node, index) => <li><div class="node"><span class="node-index">0{index + 1}</span><div><a href={`#node-${index + 1}`}><h2>{node.title}</h2></a><p>{node.question}</p><strong>{node.direction}</strong></div></div><p class="alternative">{node.alternative}</p>{index < nodes.length - 1 && <span class="flow-arrow" aria-hidden="true">↓</span>}</li>)}</ol>
  <div class="validation">下一步：客户发现 → 固定工位基线 → 两工位复用检验 → 受限现场试点<br /><span>每一关都允许继续、缩小范围或停止；尚未完成验证。</span></div>
</figure>
<style>
  .decision-path { margin: 0 0 2.5rem; border: 1px solid var(--line-color); border-radius: .6rem; background: var(--card-bg); padding: 1.5rem; color: var(--deep-text); }
  figcaption > span { font-size: .65rem; letter-spacing: .15em; color: var(--primary); } figcaption > strong { display: block; font-size: 1.2rem; margin-top: .5rem; } figcaption > p { font-size: .75rem; color: var(--btn-content); margin-top: .5rem; line-height: 1.8; }
  ol { list-style: none; margin-top: 1.5rem; } li { position: relative; padding-bottom: 2rem; } .node { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: var(--btn-regular-bg); border: 1px solid var(--line-color); border-left: 2px solid var(--primary); border-radius: .3rem; } .node-index { color: var(--primary); font-size: .8rem; padding-top: .2rem; } h2 { font-size: .95rem; line-height: 1.6; margin: 0; } a:hover { color: var(--primary); } a:focus-visible { outline: 2px solid var(--primary); outline-offset: 4px; }
  .node p { font-size: .8rem; line-height: 1.8; margin-top: .4rem; color: var(--btn-content); } .node strong { display: block; font-size: .75rem; line-height: 1.7; margin-top: .5rem; font-weight: 500; } .alternative { border-left: 1px dashed var(--line-color); margin-left: 1.5rem; padding: .5rem 1rem; font-size: .7rem; line-height: 1.8; color: var(--btn-content); } .flow-arrow { position: absolute; bottom: .4rem; left: 50%; color: var(--primary); } .validation { padding: 1rem; border: 1px dashed var(--primary); font-size: .8rem; line-height: 1.9; } .validation span { font-size: .7rem; color: var(--btn-content); }
  @media (max-width: 480px) { .decision-path { padding: 1rem; } .node { gap: .65rem; padding: .8rem; } }
</style>
