---
interface Props { product: "homeagent" | "retask"; compact?: boolean; }
const { product, compact = false } = Astro.props;
const home = product === "homeagent";
const modules = home
  ? ["移动感知：观察授权区域与预设物品", "轻量操作臂：受限轻小物品取放", "小型轮式底盘：家庭单层移动与避障", "独立中控机箱：家庭权限、任务与家居协同"]
  : ["工业感知：识别受支持的包裹与姿态", "高刚度操作臂与末端：面向包裹负载配置", "承载底盘与加固基座：宽轮距、低重心", "本体控制与安全单元：校准、互锁与急停"];
---
<figure class:list={["robot-form", home ? "home" : "warehouse", compact && "compact"]}>
  <svg viewBox="0 0 520 330" role="img" aria-label={home ? "HomeAgent 概念结构：轻量小型家庭机器人，通过本地网络与独立部署的中控机箱协同；中控不在机器人本体内" : "ReTask 工业概念结构：高负载高刚度设计方向，粗壮操作臂、加固安装基座、宽轮距承载底盘与本体安全控制"}>
    <g class="grid" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M40 270H480M70 295H450M100 320H420M130 245L70 320M200 245L175 320M270 245L280 320M340 245L385 320M410 245L490 310" />
    </g>
    {home ? <g class="home-silhouette">
      <ellipse cx="210" cy="274" rx="90" ry="12" class="shadow" />
      <ellipse cx="399" cy="279" rx="42" ry="7" class="shadow" />
      <path d="M229 192C286 190 320 225 370 234" class="local-link" />
      <g stroke="currentColor" stroke-width="2" stroke-linejoin="round">
        <path d="M137 234Q130 228 141 224L228 208Q239 207 247 214L281 232Q291 238 281 244L197 262Q187 264 178 260L139 244Q131 241 137 234Z" class="body" />
        <path d="M133 236V251Q133 258 142 262L177 277Q186 281 198 278L281 260Q287 258 287 250V237L197 262Q187 265 177 261Z" class="body" />
        <path d="M193 264V278" fill="none" />
        <rect x="153" y="260" width="26" height="14" rx="6" class="wheel" />
        <rect x="253" y="254" width="26" height="14" rx="6" class="wheel" />
        <rect x="174" y="140" width="55" height="93" rx="22" class="body" />
        <path d="M185 151V220" class="panel-seam" />
        <path d="M201 141V121" fill="none" stroke-width="6" />
        <rect x="171" y="99" width="63" height="29" rx="13" class="body" />
        <rect x="181" y="108" width="42" height="11" rx="5" class="sensor" />
        <circle cx="194" cy="113.5" r="2.5" class="light" stroke="none" />
        <path d="M224 161L259 139L289 169L314 155" fill="none" stroke-width="10" class="arm" />
        <circle cx="224" cy="161" r="8" class="joint" />
        <circle cx="259" cy="139" r="7" class="joint" />
        <circle cx="289" cy="169" r="6" class="joint" />
        <path d="M313 150L327 153L326 166M311 159L316 171L328 171" fill="none" stroke-width="2.5" class="grip" />
        <rect x="207" y="187" width="10" height="20" rx="4" class="sensor" />
        <rect x="371" y="205" width="64" height="73" rx="8" class="body" data-component="independent-home-hub" />
        <rect x="379" y="212" width="48" height="6" rx="3" class="sensor" />
        <path d="M382 236H422M382 243H422M382 250H407" class="panel-seam" />
        <circle cx="418" cy="265" r="3" class="light" stroke="none" />
      </g>
      {!compact && <g class="form-labels"><text x="210" y="311" text-anchor="middle">轻量小型 · 家庭服务</text><text x="404" y="311" text-anchor="middle">独立中控机箱</text><text x="321" y="216" text-anchor="middle" class="secondary-label">本地网络</text></g>}
    </g> : <g class="industrial-silhouette">
      <ellipse cx="258" cy="293" rx="138" ry="16" class="shadow" />
      <g stroke="currentColor" stroke-width="3" stroke-linejoin="round">
        <path d="M136 240L305 216L383 250L217 280Z" class="body" />
        <path d="M136 240V271L217 301L383 274V250L217 280Z" class="body" />
        <path d="M217 280V301" fill="none" />
        <rect x="155" y="272" width="45" height="25" rx="6" class="wheel" />
        <rect x="327" y="273" width="45" height="24" rx="6" class="wheel" />
        <path d="M188 229L246 218L280 233L222 245Z" class="reinforcement" />
        <path d="M204 218V187L248 178L271 192V224L225 235Z" class="body" />
        <path d="M225 235V201L271 192M204 187L225 201M207 216L223 203M233 226L265 198" fill="none" />
        <path d="M242 184L220 103L302 66L347 115" fill="none" stroke-width="29" class="arm" />
        <path d="M242 184L220 103L302 66L347 115" fill="none" stroke-width="16" class="industrial-arm-core" />
        <circle cx="242" cy="184" r="22" class="joint" />
        <circle cx="220" cy="103" r="21" class="joint" />
        <circle cx="302" cy="66" r="17" class="joint" />
        <circle cx="347" cy="115" r="14" class="joint" />
        <circle cx="242" cy="184" r="8" class="sensor" />
        <circle cx="220" cy="103" r="7" class="sensor" />
        <path d="M347 115L366 122" fill="none" stroke-width="15" class="arm" />
        <rect x="363" y="115" width="27" height="22" rx="3" class="body" />
        <path d="M367 137V157H357M386 137V157H396" fill="none" stroke-width="5" class="grip" />
        <path d="M152 226V101" fill="none" stroke-width="8" />
        <rect x="127" y="73" width="54" height="31" rx="4" class="body" />
        <rect x="137" y="83" width="34" height="11" rx="3" class="sensor" />
        <circle cx="147" cy="88.5" r="3" class="light" stroke="none" />
        <path d="M153 247L202 266M310 244L363 257" class="stripe" stroke-width="6" />
        <rect x="267" y="263" width="42" height="16" rx="3" class="sensor" />
        <circle cx="277" cy="271" r="3" class="light" stroke="none" />
      </g>
      {!compact && <g class="form-labels"><text x="260" y="326" text-anchor="middle">宽轮距承载底盘 · 加固安装基座</text></g>}
    </g>}
    {!compact && <g class="callouts" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d={home ? "M178 112H118V80H76M314 152H352V93H420M145 250H90V233H66M435 240H471" : "M130 88H91V63H73M321 67H422V75H465M151 262H92V278H74M310 271H463"} />
      {(home ? [{x:61,y:80,n:1},{x:435,y:93,n:2},{x:51,y:233,n:3},{x:487,y:240,n:4}] : [{x:58,y:63,n:1},{x:480,y:75,n:2},{x:59,y:278,n:3},{x:478,y:271,n:4}]).map(({x,y,n}) => <g><circle cx={x} cy={y} r="14" class="badge" /><text x={x} y={y + 5} text-anchor="middle" stroke="none" fill="currentColor">{n}</text></g>)}
    </g>}
  </svg>
  {!compact && <figcaption><span class="caption">{home ? "家庭轻量形态 · 机器人与中控分体部署" : "工业承载形态 · 高负载、高刚度设计方向"}</span><ol>{modules.map((module) => <li>{module}</li>)}</ol><p class="form-boundary">{home ? "中控机箱独立于机器人本体，负责家庭级权限与任务协同；机器人保留本地运动控制、安全保护与停止能力。" : "形态表达承载与刚度优先的设计取舍；额定负载、刚度、尺寸与末端规格仍需依据包裹谱与工程评估确定。"}</p></figcaption>}
</figure>
<style>
  .robot-form { --robot-accent: #b57a45; margin: 0; color: var(--deep-text); }
  .warehouse { --robot-accent: var(--primary); }
  svg { display: block; width: 100%; height: auto; }
  .grid { opacity: .12; } .shadow { fill: var(--deep-text); opacity: .05; }
  .body { fill: var(--card-bg); } .wheel { fill: var(--btn-content); } .sensor { fill: var(--deep-text); }
  .light { fill: var(--robot-accent); } .arm, .grip { stroke: var(--robot-accent); }
  .joint, .badge { fill: var(--card-bg); } .stripe { stroke: var(--robot-accent); }
  .reinforcement { fill: var(--btn-regular-bg); } .industrial-arm-core { stroke: var(--card-bg); }
  .panel-seam { fill: none; stroke: var(--btn-content); stroke-width: 1.2; opacity: .5; }
  .local-link { fill: none; stroke: var(--robot-accent); stroke-width: 1.5; stroke-dasharray: 5 5; opacity: .65; }
  .form-labels { fill: var(--btn-content); font-size: 13px; } .secondary-label { font-size: 11px; }
  .callouts { color: var(--robot-accent); } .callouts text { font: 600 15px sans-serif; }
  .caption { display: block; color: var(--btn-content); font-size: .75rem; }
  figcaption { padding: 0 1.25rem 1.25rem; } ol { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem 1.75rem; list-style: decimal; padding-left: 1.2rem; margin-top: 1rem; font-size: .8rem; line-height: 1.6; }
  li::marker { color: var(--robot-accent); font-weight: 600; }
  .form-boundary { margin-top: .875rem; font-size: .75rem; line-height: 1.8; color: var(--btn-content); }
  @media (max-width: 480px) { ol { grid-template-columns: 1fr; } }
</style>
